@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.MarcaRespDto

@{
    ViewData["Title"] = "Detalles de la Marca";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-info-circle me-2"></i>Detalles de la Marca</h4>
            <span class="badge bg-light text-dark fs-6">ID #@Model.IdMarca</span>
        </div>
        <div class="card-body">
            <dl class="row mb-0 fs-6">
                <dt class="col-sm-4 text-muted">Nombre:</dt>
                <dd class="col-sm-8 fw-bold">@Model.Nombre</dd>

                <hr class="my-2" />

                <dt class="col-sm-4 text-muted">País de Origen:</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.PaisOrigen) ? "No registrado" : Model.PaisOrigen)</dd>

                <hr class="my-2" />

                <dt class="col-sm-4 text-muted">Estado:</dt>
                <dd class="col-sm-8">
                    @if (Model.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
            <a asp-action="Edit" asp-route-id="@Model.IdMarca" class="btn btn-warning">
                <i class="bi bi-pencil-square me-1"></i> Editar
            </a>
        </div>
    </div>
</div>