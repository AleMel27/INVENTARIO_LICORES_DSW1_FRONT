@model GESTION_INVENTARIO_LICORES_MVC.Models.DashboardViewModel

@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container-fluid py-2">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Panel de Control</h3>
            <p class="text-muted small mb-0">Resumen general del estado de inventario y movimientos.</p>
        </div>
        <div class="d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-3 border shadow-sm">
            <i class="bi bi-person-circle text-primary fs-5"></i>
            <span class="text-secondary small">Bienvenido, <strong class="text-dark">@User.Identity?.Name</strong></span>
        </div>
    </div>

    <!-- TARJETAS DE RESUMEN (KPIs) -->
    <div class="row g-3 mb-4">
        <!-- Card Productos -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold small d-block mb-1">Productos</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.Datos.TotalProductos</h3>
                    </div>
                    <div class="rounded-3 bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Stock Bajo -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold small d-block mb-1">Stock Bajo</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.Datos.ProductosStockBajo</h3>
                    </div>
                    <div class="rounded-3 bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Proveedores -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold small d-block mb-1">Proveedores</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.Datos.TotalProveedores</h3>
                    </div>
                    <div class="rounded-3 bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-truck fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Valor Inventario -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold small d-block mb-1">Valor Inventario</span>
                        <h3 class="fw-bold text-dark mb-0">S/ @Model.Datos.ValorInventario.ToString("N2")</h3>
                    </div>
                    <div class="rounded-3 bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLAS DE RESUMEN -->
    <div class="row g-4">
        <!-- Alertas de Stock Bajo (Limitado a 4) -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-exclamation text-danger fs-5"></i>
                        <h6 class="fw-bold text-dark mb-0">Alertas de Stock Bajo</h6>
                    </div>
                    <a asp-controller="Producto" asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium">Ver Todos</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-3 py-3">Producto</th>
                                    <th>Categoría</th>
                                    <th class="text-center">Stock Actual</th>
                                    <th class="text-center pe-3">Mínimo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Datos.AlertasStock != null && Model.Datos.AlertasStock.Any())
                                {
                                    @foreach (var item in Model.Datos.AlertasStock.Take(4))
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold text-dark">@item.Nombre</td>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                    @item.Categoria
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-danger-subtle text-danger fw-bold px-2 py-1">
                                                    @item.StockActual
                                                </span>
                                            </td>
                                            <td class="text-center text-muted pe-3">@item.StockMinimo</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">
                                            <i class="bi bi-check-circle text-success me-1 fs-6"></i>
                                            No hay alertas de stock bajo actualmente.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Últimas Compras (Limitado a 4) -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-receipt text-primary fs-5"></i>
                        <h6 class="fw-bold text-dark mb-0">Últimas Compras Registradas</h6>
                    </div>
                    <a asp-controller="Compra" asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium">Ver Todas</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-3 py-3">Código</th>
                                    <th>Proveedor</th>
                                    <th>Fecha</th>
                                    <th class="text-end pe-3">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Datos.UltimasCompras != null && Model.Datos.UltimasCompras.Any())
                                {
                                    @foreach (var item in Model.Datos.UltimasCompras.Take(4))
                                    {
                                        <tr>
                                            <td class="ps-3 font-monospace text-primary fw-bold">@item.Codigo</td>
                                            <td class="text-dark">@item.Proveedor</td>
                                            <td class="text-muted small">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end fw-bold text-dark pe-3">S/ @item.Total.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">
                                            <i class="bi bi-inbox text-muted me-1 fs-6"></i>
                                            No se han registrado compras recientemente.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>