@model GESTION_INVENTARIO_LICORES_MVC.Models.InventarioIndexViewModel

@{
    ViewData["Title"] = "Gestión de Inventario";
}

<div class="container-fluid py-3">
    <!-- Mensajes de Notificación -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado de Página -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-boxes text-primary fs-4"></i>
            <h4 class="fw-bold text-dark mb-0">Control de Inventario</h4>
        </div>
    </div>

    <!-- Barra de Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body p-3 bg-white">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label asp-for="Filtro.NombreProducto" class="form-label small fw-semibold text-secondary">Producto</label>
                    <input type="text" asp-for="Filtro.NombreProducto" class="form-control form-control-sm" placeholder="Buscar por producto..." autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Filtro.CodigoProducto" class="form-label small fw-semibold text-secondary">Código</label>
                    <input type="text" asp-for="Filtro.CodigoProducto" class="form-control form-control-sm" placeholder="Buscar por código..." autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Filtro.IdAlmacen" class="form-label small fw-semibold text-secondary">Almacén</label>
                    <select asp-for="Filtro.IdAlmacen" class="form-select form-select-sm">
                        <option value="">-- Todos los Almacenes --</option>
                        @foreach (var alm in Model.Almacenes)
                        {
                            <option value="@alm.IdAlmacen">@alm.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-medium">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-light border text-secondary" title="Limpiar Filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Inventario -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th scope="col" style="width: 100px;" class="ps-3 py-3">ID</th>
                            <th scope="col" style="width: 140px;" class="py-3">Código</th>
                            <th scope="col" class="py-3">Producto</th>
                            <th scope="col" class="py-3">Almacén</th>
                            <th scope="col" class="text-center py-3" style="width: 140px;">Stock Actual</th>
                            <th scope="col" class="text-center py-3 pe-3" style="width: 160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model.Resultado.Items != null && Model.Resultado.Items.Any())
                        {
                            @foreach (var item in Model.Resultado.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-light text-secondary border font-monospace">#@item.IdInventario</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">@item.Producto.Codigo</span>
                                    </td>
                                    <td class="fw-medium text-dark">@item.Producto.Nombre</td>
                                    <td class="text-secondary">
                                        <i class="bi bi-building me-1 text-muted"></i>@item.Almacen.Nombre
                                    </td>
                                    <td class="text-center">
                                        @if (item.StockActual <= 5)
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-2 py-1">
                                                <i class="bi bi-exclamation-triangle me-1"></i>@item.StockActual u.
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success px-2 py-1">
                                                @item.StockActual u.
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        <button type="button"
                                                class="btn btn-sm btn-light border text-warning"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalAjuste"
                                                data-id="@item.IdInventario"
                                                data-producto="@item.Producto.Nombre"
                                                data-almacen="@item.Almacen.Nombre"
                                                data-stock="@item.StockActual"
                                                title="Ajustar Stock">
                                            <i class="bi bi-sliders me-1"></i> Ajustar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                    No se encontraron registros de inventario con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación -->
    @if (Model.Resultado.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Página @Model.Resultado.PageNumber de @Model.Resultado.TotalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.Resultado.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-PageNumber="@(Model.Resultado.PageNumber - 1)"
                           asp-route-NombreProducto="@Model.Filtro.NombreProducto"
                           asp-route-CodigoProducto="@Model.Filtro.CodigoProducto"
                           asp-route-IdAlmacen="@Model.Filtro.IdAlmacen">Anterior</a>
                    </li>
                    <li class="page-item @(!Model.Resultado.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-PageNumber="@(Model.Resultado.PageNumber + 1)"
                           asp-route-NombreProducto="@Model.Filtro.NombreProducto"
                           asp-route-CodigoProducto="@Model.Filtro.CodigoProducto"
                           asp-route-IdAlmacen="@Model.Filtro.IdAlmacen">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- MODAL: ASIGNAR PRODUCTO A ALMACÉN -->
<div class="modal fade" id="modalNuevoInventario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-white border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Asignar Producto a Almacén
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Producto <span class="text-danger">*</span></label>
                        <select name="IdProducto" class="form-select form-select-sm" required>
                            <option value="">-- Seleccione Producto --</option>
                            @foreach (var prod in Model.Productos)
                            {
                                <option value="@prod.IdProducto">[@prod.Codigo] @prod.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Almacén <span class="text-danger">*</span></label>
                        <select name="IdAlmacen" class="form-select form-select-sm" required>
                            <option value="">-- Seleccione Almacén --</option>
                            @foreach (var alm in Model.Almacenes)
                            {
                                <option value="@alm.IdAlmacen">@alm.Nombre (@alm.Ubicacion)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-sm btn-light border text-secondary fw-medium px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary fw-medium px-3">
                        <i class="bi bi-check-lg me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: AJUSTE DE INVENTARIO -->
<div class="modal fade" id="modalAjuste" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            <form id="formAjuste" asp-action="Ajustar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="idInventarioAjuste" name="idInventario" value="" />
                
                <div class="modal-header bg-white border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-sliders text-warning me-2"></i>Ajustar Stock de Inventario
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Resumen contextual del item -->
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="row g-2 small">
                            <div class="col-12">
                                <span class="text-muted text-uppercase fw-semibold d-block">Producto</span>
                                <span id="lblProducto" class="fw-bold text-dark fs-6"></span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted text-uppercase fw-semibold d-block">Almacén</span>
                                <span id="lblAlmacen" class="fw-medium text-secondary"></span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted text-uppercase fw-semibold d-block">Stock Actual</span>
                                <span id="lblStock" class="badge bg-secondary-subtle text-secondary border"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Tipo de Movimiento <span class="text-danger">*</span></label>
                        <select name="IdTipoMovimiento" class="form-select form-select-sm" required>
                            <option value="">-- Seleccione Tipo --</option>
                            @foreach (var tm in Model.TiposMovimiento)
                            {
                                var nombreUpper = tm.Nombre?.ToUpper() ?? "";

                                if (nombreUpper.Contains("AJUSTE"))
                                {
                                    string nombreMostrar = tm.Nombre;

                                    if (nombreUpper.Contains("ENTRADA"))
                                    {
                                        nombreMostrar = "Entrada por Ajuste (+)";
                                    }
                                    else if (nombreUpper.Contains("SALIDA"))
                                    {
                                        nombreMostrar = "Salida por Ajuste (-)";
                                    }

                                    <option value="@tm.IdTipoMovimiento">@nombreMostrar</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Cantidad <span class="text-danger">*</span></label>
                        <input type="number" name="Cantidad" class="form-control form-control-sm" min="1" required placeholder="Ingrese la cantidad" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Motivo <span class="text-danger">*</span></label>
                        <textarea name="Motivo" class="form-control form-control-sm" rows="2" maxlength="255" required placeholder="Ej: Merma por rotura, Corrección de conteo físico..."></textarea>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-secondary">Referencia (Opcional)</label>
                        <input type="text" name="Referencia" class="form-control form-control-sm" maxlength="100" placeholder="Ej: AUD-2026-01" autocomplete="off" />
                    </div>
                </div>

                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-sm btn-light border text-secondary fw-medium px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-warning fw-medium px-3">
                        <i class="bi bi-check-lg me-1"></i> Procesar Ajuste
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var modalAjuste = document.getElementById('modalAjuste');
            if (modalAjuste) {
                modalAjuste.addEventListener('show.bs.modal', function(event) {
                    var button = event.relatedTarget;
                    var id = button.getAttribute('data-id');
                    var producto = button.getAttribute('data-producto');
                    var almacen = button.getAttribute('data-almacen');
                    var stock = button.getAttribute('data-stock');

                    document.getElementById('idInventarioAjuste').value = id;
                    document.getElementById('lblProducto').textContent = producto;
                    document.getElementById('lblAlmacen').textContent = almacen;
                    document.getElementById('lblStock').textContent = stock + ' unidades';
                });
            }
        });
    </script>
}