@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.PaginatedRespDto<GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.ProveedorRespDto>

@{
    ViewData["Title"] = "Gestión de Proveedores";

    int currentEstado = ViewData["CurrentEstado"] != null ? (int)ViewData["CurrentEstado"] : 0;
    string currentOrden = ViewData["CurrentOrden"] as string ?? "DESC";
    string nextOrden = currentOrden == "ASC" ? "DESC" : "ASC";
}

<div class="container-fluid py-3">
    <!-- Mensajes de Notificación -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado de Página -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-truck text-primary fs-4"></i>
            <h4 class="fw-bold text-dark mb-0">Listado de Proveedores</h4>
        </div>
        <a asp-action="Create" class="btn btn-sm btn-primary fw-medium px-3">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Proveedor
        </a>
    </div>

    <!-- Barra de Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body p-3 bg-white">
            <form id="filterForm" method="get" asp-action="Index">
                <input type="hidden" name="orden" value="@currentOrden" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label for="selectEstado" class="form-label small fw-semibold text-secondary">Estado</label>
                        <select id="selectEstado" name="estado" class="form-select form-select-sm">
                            <option value="0" selected="@(currentEstado == 0)">Activos</option>
                            <option value="1" selected="@(currentEstado == 1)">Inactivos</option>
                            <option value="2" selected="@(currentEstado == 2)">Todos</option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-medium">
                            <i class="bi bi-search me-1"></i> Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-light border text-secondary" title="Limpiar Filtros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla principal -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th scope="col" class="ps-3 py-3" style="width: 110px;">
                                <a asp-action="Index"
                                   asp-route-estado="@currentEstado"
                                   asp-route-orden="@nextOrden"
                                   class="text-secondary text-decoration-none d-flex align-items-center justify-content-between">
                                    ID
                                    @if (currentOrden == "ASC")
                                    {
                                        <i class="bi bi-arrow-up-short fs-6"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-down-short fs-6"></i>
                                    }
                                </a>
                            </th>
                            <th scope="col" class="py-3">RUC</th>
                            <th scope="col" class="py-3">Razón Social</th>
                            <th scope="col" class="py-3">Teléfono</th>
                            <th scope="col" class="py-3">Correo</th>
                            <th scope="col" class="text-center py-3" style="width: 110px;">Estado</th>
                            <th scope="col" class="text-center py-3 pe-3" style="width: 1%;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model != null && Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-light text-secondary border font-monospace">#@item.IdProveedor</span>
                                    </td>
                                    <td class="font-monospace text-dark">@item.Ruc</td>
                                    <td class="fw-medium text-dark">@item.RazonSocial</td>
                                    <td class="text-secondary small">@(string.IsNullOrEmpty(item.Telefono) ? "-" : item.Telefono)</td>
                                    <td class="text-secondary small">@(string.IsNullOrEmpty(item.Correo) ? "-" : item.Correo)</td>
                                    <td class="text-center">
                                        @if (item.Estado)
                                        {
                                            <span class="badge px-2 py-1 bg-success-subtle text-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge px-2 py-1 bg-secondary-subtle text-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3 text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@item.IdProveedor" class="btn btn-light border text-secondary" title="Ver Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.IdProveedor" class="btn btn-light border text-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <button type="button"
                                                    class="btn btn-light border @(item.Estado ? "text-danger" : "text-success")"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#confirmStatusModal"
                                                    data-id="@item.IdProveedor"
                                                    data-nombre="@item.RazonSocial"
                                                    data-estado="@item.Estado.ToString().ToLower()"
                                                    title="@(item.Estado ? "Desactivar" : "Activar")">
                                                <i class="bi @(item.Estado ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                    No se encontraron proveedores con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Página @Model.PageNumber de @Model.TotalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-estado="@currentEstado"
                           asp-route-orden="@currentOrden">Anterior</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@i"
                               asp-route-estado="@currentEstado"
                               asp-route-orden="@currentOrden">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-estado="@currentEstado"
                           asp-route-orden="@currentOrden">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Formulario Oculto para cambio de estado -->
<form id="formChangeStatus" asp-action="ChangeStatus" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="inputEstadoActual" name="estadoActual" value="" />
</form>

<!-- Modal de Confirmación Estilizado -->
<div class="modal fade" id="confirmStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom py-2 px-3" id="modalHeaderBg">
                <h6 class="modal-title fw-bold" id="confirmStatusModalLabel">Confirmar Acción</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 text-secondary small" id="modalBodyText">
            </div>
            <div class="modal-footer bg-light border-top py-2 px-3">
                <button type="button" class="btn btn-sm btn-light border text-secondary fw-medium" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm fw-medium px-3" id="btnConfirmStatus">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterForm = document.getElementById('filterForm');
            const selectEstado = document.getElementById('selectEstado');

            selectEstado.addEventListener('change', function() {
                filterForm.submit();
            });

            const confirmModal = document.getElementById('confirmStatusModal');
            if (confirmModal) {
                confirmModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;

                    const id = button.getAttribute('data-id');
                    const nombre = button.getAttribute('data-nombre');
                    const esActivo = button.getAttribute('data-estado') === 'true';

                    const modalHeaderBg = document.getElementById('modalHeaderBg');
                    const modalBodyText = document.getElementById('modalBodyText');
                    const btnConfirm = document.getElementById('btnConfirmStatus');
                    const form = document.getElementById('formChangeStatus');
                    const inputEstado = document.getElementById('inputEstadoActual');

                    form.action = `/Proveedor/ChangeStatus/${id}`;
                    inputEstado.value = esActivo ? 'true' : 'false';

                    if (esActivo) {
                        modalHeaderBg.className = 'modal-header bg-danger text-white border-bottom py-2 px-3';
                        modalBodyText.innerHTML = `¿Está seguro de desactivar al proveedor <strong class="text-dark">${nombre}</strong>?`;
                        btnConfirm.className = 'btn btn-sm btn-danger fw-medium px-3';
                        btnConfirm.textContent = 'Desactivar';
                    } else {
                        modalHeaderBg.className = 'modal-header bg-success text-white border-bottom py-2 px-3';
                        modalBodyText.innerHTML = `¿Está seguro de activar al proveedor <strong class="text-dark">${nombre}</strong>?`;
                        btnConfirm.className = 'btn btn-sm btn-success fw-medium px-3';
                        btnConfirm.textContent = 'Activar';
                    }

                    btnConfirm.onclick = function() {
                        form.submit();
                    };
                });
            }
        });
    </script>
}