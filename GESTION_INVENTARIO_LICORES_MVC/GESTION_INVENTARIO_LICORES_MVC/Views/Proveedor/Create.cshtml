@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Request.ProveedorReqDto

@{
    ViewData["Title"] = "Crear Proveedor";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-truck text-primary me-2"></i>Registrar Nuevo Proveedor
                    </h5>
                </div>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Ruc" class="form-label small fw-semibold text-secondary">RUC <span class="text-danger">*</span></label>
                                <input asp-for="Ruc" class="form-control form-control-sm" placeholder="11 dígitos" maxlength="11" autofocus autocomplete="off" />
                                <span asp-validation-for="Ruc" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RazonSocial" class="form-label small fw-semibold text-secondary">Razón Social <span class="text-danger">*</span></label>
                                <input asp-for="RazonSocial" class="form-control form-control-sm" placeholder="Ej. Licores del Perú S.A.C." autocomplete="off" />
                                <span asp-validation-for="RazonSocial" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label small fw-semibold text-secondary">Teléfono</label>
                                <input asp-for="Telefono" class="form-control form-control-sm" placeholder="Ej. 987654321" autocomplete="off" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Correo" class="form-label small fw-semibold text-secondary">Correo Electrónico</label>
                                <input asp-for="Correo" class="form-control form-control-sm" type="email" placeholder="contacto@empresa.com" autocomplete="off" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Direccion" class="form-label small fw-semibold text-secondary">Dirección</label>
                                <input asp-for="Direccion" class="form-control form-control-sm" placeholder="Ej. Av. Principal 456, Lima" autocomplete="off" />
                                <span asp-validation-for="Direccion" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light border-top py-2 px-4 d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-sm btn-primary fw-medium px-3">
                            <i class="bi bi-check-lg me-1"></i> Guardar Proveedor
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}