@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.ProveedorRespDto

@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-info-circle text-primary me-2"></i>Detalles del Proveedor
                    </h5>
                    @if (Model.Estado)
                    {
                        <span class="badge px-2 py-1 bg-success-subtle text-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge px-2 py-1 bg-secondary-subtle text-secondary">Inactivo</span>
                    }
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">ID Proveedor</span>
                            <span class="badge bg-light text-secondary border font-monospace fs-6">#@Model.IdProveedor</span>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">RUC</span>
                            <p class="text-dark font-monospace mb-0 fw-medium">@Model.Ruc</p>
                        </div>

                        <div class="col-12">
                            <hr class="text-muted opacity-25 my-1" />
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Razón Social</span>
                            <p class="text-dark fw-bold mb-0">@Model.RazonSocial</p>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Teléfono</span>
                            <p class="text-secondary small mb-0">@(string.IsNullOrWhiteSpace(Model.Telefono) ? "-" : Model.Telefono)</p>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Correo Electrónico</span>
                            <p class="text-secondary small mb-0">@(string.IsNullOrWhiteSpace(Model.Correo) ? "-" : Model.Correo)</p>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Dirección</span>
                            <p class="text-secondary small mb-0">
                                @if (!string.IsNullOrWhiteSpace(Model.Direccion))
                                {
                                    <i class="bi bi-geo-alt me-1 text-muted"></i>
                                    @Model.Direccion
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light border-top py-2 px-4 d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                        <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.IdProveedor" class="btn btn-sm btn-warning text-dark fw-medium px-3">
                        <i class="bi bi-pencil me-1"></i> Editar Proveedor
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>