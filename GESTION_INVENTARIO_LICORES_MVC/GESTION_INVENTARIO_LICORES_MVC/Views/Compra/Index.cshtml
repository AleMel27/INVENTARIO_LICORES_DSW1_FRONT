@model GESTION_INVENTARIO_LICORES_MVC.Models.CompraIndexViewModel

@{
    ViewData["Title"] = "Gestión de Compras";
    var f = Model.Filtro;
}

<div class="container-fluid py-3">
    <!-- Mensajes de Notificación -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado de Página -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-cart-check text-primary fs-4"></i>
            <h4 class="fw-bold text-dark mb-0">Listado de Compras</h4>
        </div>
        <a asp-action="Create" class="btn btn-sm btn-primary fw-medium px-3">
            <i class="bi bi-plus-lg me-1"></i> Nueva Compra
        </a>
    </div>

    <!-- Barra de Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body p-3 bg-white">
            <form asp-action="Index" method="get">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Estado</label>
                        <select name="Estado" class="form-select form-select-sm">
                            <option value="" selected="@(string.IsNullOrEmpty(f.Estado))">Todos</option>
                            <option value="PENDIENTE" selected="@(f.Estado == "PENDIENTE")">PENDIENTE</option>
                            <option value="RECIBIDA" selected="@(f.Estado == "RECIBIDA")">RECIBIDA</option>
                            <option value="CANCELADA" selected="@(f.Estado == "CANCELADA")">CANCELADA</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Tipo Comprobante</label>
                        <select name="IdTipoComprobante" class="form-select form-select-sm">
                            <option value="">Todos</option>
                            @foreach (var tipo in Model.TiposComprobante)
                            {
                                <option value="@tipo.IdTipoComprobante" selected="@(f.IdTipoComprobante == tipo.IdTipoComprobante)">
                                    @tipo.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Almacén</label>
                        <select name="IdAlmacen" class="form-select form-select-sm">
                            <option value="">Todos</option>
                            @foreach (var almacen in Model.Almacenes)
                            {
                                <option value="@almacen.IdAlmacen" selected="@(f.IdAlmacen == almacen.IdAlmacen)">
                                    @almacen.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Fecha</label>
                        <input type="date" name="Fecha" class="form-control form-control-sm" value="@f.Fecha?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Proveedor</label>
                        <input type="text" name="RazonSocial" class="form-control form-control-sm" value="@f.RazonSocial" placeholder="Buscar proveedor..." autocomplete="off" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">N° Comprobante</label>
                        <input type="text" name="NumeroComprobante" class="form-control form-control-sm" value="@f.NumeroComprobante" placeholder="N° Doc..." autocomplete="off" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Orden</label>
                        <select name="Orden" class="form-select form-select-sm">
                            <option value="DESC" selected="@(f.Orden == "DESC")">Más recientes</option>
                            <option value="ASC" selected="@(f.Orden == "ASC")">Más antiguos</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-1 ms-auto">
                        <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-medium">
                            <i class="bi bi-search me-1"></i> Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-light border text-secondary" title="Limpiar Filtros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla Principal -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th scope="col" class="ps-3 py-3">N° Comprobante</th>
                            <th scope="col" class="py-3">Proveedor</th>
                            <th scope="col" class="py-3">Tipo</th>
                            <th scope="col" class="py-3">Almacén</th>
                            <th scope="col" class="py-3">Fecha</th>
                            <th scope="col" class="py-3">Usuario</th>
                            <th scope="col" class="py-3">Total</th>
                            <th scope="col" class="text-center py-3">Estado</th>
                            <th scope="col" class="text-center py-3 pe-3" style="width: 1%;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model.Resultado.Items != null && Model.Resultado.Items.Any())
                        {
                            @foreach (var compra in Model.Resultado.Items)
                            {
                                var badgeClass = compra.Estado switch
                                {
                                    "RECIBIDA" => "bg-success-subtle text-success",
                                    "CANCELADA" => "bg-danger-subtle text-danger",
                                    "PENDIENTE" => "bg-warning-subtle text-warning-emphasis",
                                    _ => "bg-secondary-subtle text-secondary"
                                };

                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-light text-secondary border font-monospace">@compra.NumeroComprobante</span>
                                    </td>
                                    <td class="fw-medium text-dark">@compra.Proveedor.RazonSocial</td>
                                    <td class="text-secondary small">@compra.TipoComprobante.Nombre</td>
                                    <td class="text-secondary small">@compra.Almacen.Nombre</td>
                                    <td class="text-secondary small">@compra.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-muted small">@compra.Usuario.Nombres @compra.Usuario.Apellidos</td>
                                    <td class="fw-bold text-dark">S/ @compra.Total.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge px-2 py-1 @badgeClass">@compra.Estado</span>
                                    </td>
                                    <td class="text-center pe-3 text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@compra.IdCompra" class="btn btn-light border text-secondary" title="Ver Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (compra.Estado == "PENDIENTE")
                                            {
                                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@compra.IdCompra" />
                                                    <input type="hidden" name="nuevoEstado" value="RECIBIDA" />
                                                    <button type="submit" class="btn btn-sm btn-light border text-success" title="Marcar como Recibida" onclick="return confirm('¿Marcar compra como RECIBIDA?');">
                                                        <i class="bi bi-check-circle me-1"></i>
                                                    </button>
                                                </form>

                                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@compra.IdCompra" />
                                                    <input type="hidden" name="nuevoEstado" value="CANCELADA" />
                                                    <button type="submit" class="btn btn-sm btn-light border text-danger" title="Cancelar Compra" onclick="return confirm('¿Está seguro de CANCELAR esta compra?');">
                                                        <i class="bi bi-slash-circle me-1"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                    No se encontraron registros de compras.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación -->
    @if (Model.Resultado.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Página @Model.Resultado.PageNumber de @Model.Resultado.TotalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Resultado.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-PageNumber="@(Model.Resultado.PageNumber - 1)"
                           asp-route-Estado="@f.Estado"
                           asp-route-IdTipoComprobante="@f.IdTipoComprobante"
                           asp-route-IdAlmacen="@f.IdAlmacen"
                           asp-route-Fecha="@f.Fecha?.ToString("yyyy-MM-dd")"
                           asp-route-RazonSocial="@f.RazonSocial"
                           asp-route-NumeroComprobante="@f.NumeroComprobante"
                           asp-route-Orden="@f.Orden">Anterior</a>
                    </li>

                    @for (int i = 1; i <= Model.Resultado.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Resultado.PageNumber ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@i"
                               asp-route-Estado="@f.Estado"
                               asp-route-IdTipoComprobante="@f.IdTipoComprobante"
                               asp-route-IdAlmacen="@f.IdAlmacen"
                               asp-route-Fecha="@f.Fecha?.ToString("yyyy-MM-dd")"
                               asp-route-RazonSocial="@f.RazonSocial"
                               asp-route-NumeroComprobante="@f.NumeroComprobante"
                               asp-route-Orden="@f.Orden">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.Resultado.HasNextPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-PageNumber="@(Model.Resultado.PageNumber + 1)"
                           asp-route-Estado="@f.Estado"
                           asp-route-IdTipoComprobante="@f.IdTipoComprobante"
                           asp-route-IdAlmacen="@f.IdAlmacen"
                           asp-route-Fecha="@f.Fecha?.ToString("yyyy-MM-dd")"
                           asp-route-RazonSocial="@f.RazonSocial"
                           asp-route-NumeroComprobante="@f.NumeroComprobante"
                           asp-route-Orden="@f.Orden">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>