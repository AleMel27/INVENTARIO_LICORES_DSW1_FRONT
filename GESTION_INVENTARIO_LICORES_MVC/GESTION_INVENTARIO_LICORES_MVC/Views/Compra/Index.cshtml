@model GESTION_INVENTARIO_LICORES_MVC.Models.CompraIndexViewModel

@{
    ViewData["Title"] = "Compras";
    var f = Model.Filtro;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-cart-check"></i> Compras</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Nueva Compra
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <label class="form-label">Estado</label>
        <select name="Estado" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(f.Estado))">Todos</option>
            <option value="PENDIENTE" selected="@(f.Estado == "PENDIENTE")">PENDIENTE</option>
            <option value="RECIBIDA" selected="@(f.Estado == "RECIBIDA")">RECIBIDA</option>
            <option value="CANCELADA" selected="@(f.Estado == "CANCELADA")">CANCELADA</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Tipo Comprobante</label>
        <select name="IdTipoComprobante" class="form-select">
            <option value="">Todos</option>
            @foreach (var tipo in Model.TiposComprobante)
            {
                <option value="@tipo.IdTipoComprobante" selected="@(f.IdTipoComprobante == tipo.IdTipoComprobante)">
                    @tipo.Nombre
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Almacén</label>
        <select name="IdAlmacen" class="form-select">
            <option value="">Todos</option>
            @foreach (var almacen in Model.Almacenes)
            {
                <option value="@almacen.IdAlmacen" selected="@(f.IdAlmacen == almacen.IdAlmacen)">
                    @almacen.Nombre
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Fecha</label>
        <input type="date" name="Fecha" class="form-control" value="@f.Fecha?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Proveedor</label>
        <input type="text" name="RazonSocial" class="form-control" value="@f.RazonSocial" placeholder="Proveedor" />
    </div>

    <div class="col-md-2">
        <label class="form-label">N° Comprobante</label>
        <input type="text" name="NumeroComprobante" class="form-control" value="@f.NumeroComprobante" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Orden</label>
        <select name="Orden" class="form-select">
            <option value="DESC" selected="@(f.Orden == "DESC")">Más recientes</option>
            <option value="ASC" selected="@(f.Orden == "ASC")">Más antiguos</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">N° Comprobante</th>
                        <th>Proveedor</th>
                        <th>Tipo</th>
                        <th>Almacén</th>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Resultado.Items != null && Model.Resultado.Items.Any())
                    {
                        @foreach (var compra in Model.Resultado.Items)
                        {
                            var badgeClass = compra.Estado switch
                            {
                                "RECIBIDA" => "bg-success",
                                "CANCELADA" => "bg-danger",
                                "PENDIENTE" => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="ps-3 fw-bold">@compra.NumeroComprobante</td>
                                <td>@compra.Proveedor.RazonSocial</td>
                                <td>@compra.TipoComprobante.Nombre</td>
                                <td>@compra.Almacen.Nombre</td>
                                <td>@compra.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@compra.Usuario.Nombres @compra.Usuario.Apellidos</td>
                                <td class="fw-bold">S/ @compra.Total.ToString("N2")</td>
                                <td><span class="badge @badgeClass">@compra.Estado</span></td>
                                <td class="text-end pe-3" style="width: 120px; white-space: nowrap;">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            Acciones
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a asp-action="Details" asp-route-id="@compra.IdCompra" class="dropdown-item">
                                                    <i class="bi bi-eye text-info me-2"></i> Ver detalle
                                                </a>
                                            </li>

                                            @if (compra.Estado == "PENDIENTE")
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li><h6 class="dropdown-header">Cambiar Estado</h6></li>

                                                <li>
                                                    <form asp-action="CambiarEstado" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@compra.IdCompra" />
                                                        <input type="hidden" name="nuevoEstado" value="RECIBIDA" />
                                                        <button type="submit" class="dropdown-item text-success" onclick="return confirm('¿Marcar compra como RECIBIDA?');">
                                                            <i class="bi bi-check-circle me-2"></i> Marcar Recibida
                                                        </button>
                                                    </form>
                                                </li>

                                                <li>
                                                    <form asp-action="CambiarEstado" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@compra.IdCompra" />
                                                        <input type="hidden" name="nuevoEstado" value="CANCELADA" />
                                                        <button type="submit" class="dropdown-item text-danger" onclick="return confirm('¿Está seguro de CANCELAR esta compra?');">
                                                            <i class="bi bi-x-circle me-2"></i> Marcar Cancelada
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No se encontraron registros de compras.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.Resultado.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.Resultado.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Resultado.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@i"
                       asp-route-Estado="@f.Estado"
                       asp-route-IdTipoComprobante="@f.IdTipoComprobante"
                       asp-route-IdAlmacen="@f.IdAlmacen"
                       asp-route-Fecha="@f.Fecha?.ToString("yyyy-MM-dd")"
                       asp-route-RazonSocial="@f.RazonSocial"
                       asp-route-NumeroComprobante="@f.NumeroComprobante"
                       asp-route-Orden="@f.Orden">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}