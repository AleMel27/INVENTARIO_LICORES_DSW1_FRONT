@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.CompraDetalleRespDto

@{
    ViewData["Title"] = $"Detalle de Compra #{Model.NumeroComprobante}";

    var badgeClass = Model.Estado switch
    {
        "RECIBIDA" => "bg-success-subtle text-success",
        "CANCELADA" => "bg-danger-subtle text-danger",
        "PENDIENTE" => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-secondary-subtle text-secondary"
    };
}

<div class="container-fluid py-3">
    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado y Acciones de Cabecera -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-receipt text-primary fs-4"></i>
            <div>
                <h4 class="fw-bold text-dark mb-0">Compra <span class="font-monospace">#@Model.NumeroComprobante</span></h4>
            </div>
            <span class="badge px-2 py-1 ms-2 @badgeClass">@Model.Estado</span>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Estado == "PENDIENTE")
            {
                <form asp-action="CambiarEstado" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdCompra" />
                    <input type="hidden" name="nuevoEstado" value="RECIBIDA" />
                    <button type="submit" class="btn btn-sm btn-success fw-medium px-3" onclick="return confirm('¿Marcar compra como RECIBIDA?');">
                        <i class="bi bi-check-circle me-1"></i> Marcar Recibida
                    </button>
                </form>

                <form asp-action="CambiarEstado" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdCompra" />
                    <input type="hidden" name="nuevoEstado" value="CANCELADA" />
                    <button type="submit" class="btn btn-sm btn-outline-danger fw-medium px-3" onclick="return confirm('¿Está seguro de CANCELAR esta compra?');">
                        <i class="bi bi-slash-circle me-1"></i> Cancelar Compra
                    </button>
                </form>
            }

            <button onclick="window.print()" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                <i class="bi bi-printer me-1"></i> Imprimir
            </button>
            <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <!-- Cards Informativos -->
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 bg-white">
                    <span class="text-muted text-uppercase fw-semibold small d-block mb-2">Comprobante</span>
                    <p class="mb-1 text-secondary small"><strong>N° Documento:</strong> <span class="text-dark">@Model.NumeroComprobante</span></p>
                    <p class="mb-1 text-secondary small"><strong>Tipo:</strong> <span class="text-dark">@Model.TipoComprobante.Nombre</span></p>
                    <p class="mb-1 text-secondary small"><strong>Fecha:</strong> <span class="text-dark">@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</span></p>
                    <p class="mb-0 text-secondary small"><strong>Usuario:</strong> <span class="text-dark">@Model.Usuario.Nombres @Model.Usuario.Apellidos</span></p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 bg-white">
                    <span class="text-muted text-uppercase fw-semibold small d-block mb-2">Proveedor</span>
                    <p class="mb-1 text-secondary small"><strong>Razón Social:</strong> <span class="text-dark fw-medium">@Model.Proveedor.RazonSocial</span></p>
                    <p class="mb-0 text-secondary small"><strong>RUC:</strong> <span class="text-dark font-monospace">@Model.Proveedor.Ruc</span></p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 bg-white">
                    <span class="text-muted text-uppercase fw-semibold small d-block mb-2">Almacén Destino</span>
                    <p class="mb-1 text-secondary small"><strong>Nombre:</strong> <span class="text-dark fw-medium">@Model.Almacen.Nombre</span></p>
                    <p class="mb-0 text-secondary small"><strong>Ubicación:</strong> <span class="text-dark"><i class="bi bi-geo-alt me-1 text-muted"></i>@Model.Almacen.Ubicacion</span></p>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Observacion))
    {
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body p-3 bg-white">
                <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Observación</span>
                <p class="text-secondary small mb-0">@Model.Observacion</p>
            </div>
        </div>
    }

    <!-- Tabla de Detalles -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-3">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <h6 class="fw-bold text-dark mb-0">
                <i class="bi bi-box-seam text-primary me-2"></i>Productos Comprados
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th scope="col" class="ps-3 py-3" style="width: 60px;">#</th>
                            <th scope="col" class="py-3">Producto</th>
                            <th scope="col" class="text-center py-3">Cantidad</th>
                            <th scope="col" class="text-end py-3">Costo Unitario</th>
                            <th scope="col" class="text-end py-3 pe-3">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model.Detalles != null && Model.Detalles.Any())
                        {
                            int index = 1;
                            @foreach (var item in Model.Detalles)
                            {
                                var subtotal = item.Cantidad * item.CostoUnitario;
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-light text-secondary border font-monospace">@index</span>
                                    </td>
                                    <td class="fw-medium text-dark">@item.Producto.Nombre</td>
                                    <td class="text-center text-secondary">@item.Cantidad</td>
                                    <td class="text-end text-secondary">S/ @item.CostoUnitario.ToString("N2")</td>
                                    <td class="text-end pe-3 fw-bold text-dark">S/ @subtotal.ToString("N2")</td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No hay ítems registrados en esta compra.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light border-top">
                        <tr>
                            <td colspan="4" class="text-end fw-bold text-secondary py-3">Total Compra:</td>
                            <td class="text-end pe-3 fw-bold fs-6 text-primary py-3">S/ @Model.Total.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>