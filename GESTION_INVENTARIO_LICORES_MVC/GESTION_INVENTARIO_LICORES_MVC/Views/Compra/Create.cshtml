@model GESTION_INVENTARIO_LICORES_MVC.Models.CompraCreateViewModel

@{
    ViewData["Title"] = "Nueva Compra";
    var c = Model.Compra;
}

<h2>Nueva Compra</h2>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="Create" method="post" id="formCompra">
    @Html.AntiForgeryToken()

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <label class="form-label">Proveedor</label>
            <select name="IdProveedor" class="form-select" required>
                <option value="">Seleccione...</option>
                @foreach (var p in Model.Proveedores)
                {
                    <option value="@p.IdProveedor" selected="@(c.IdProveedor == p.IdProveedor)">
                        @p.RazonSocial (@p.Ruc)
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Tipo Comprobante</label>
            <select name="IdTipoComprobante" class="form-select" required>
                <option value="">Seleccione...</option>
                @foreach (var t in Model.TiposComprobante)
                {
                    <option value="@t.IdTipoComprobante" selected="@(c.IdTipoComprobante == t.IdTipoComprobante)">
                        @t.Nombre
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Almacén</label>
            <select name="IdAlmacen" class="form-select" required>
                <option value="">Seleccione...</option>
                @foreach (var a in Model.Almacenes)
                {
                    <option value="@a.IdAlmacen" selected="@(c.IdAlmacen == a.IdAlmacen)">
                        @a.Nombre
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">N° Comprobante</label>
            <input type="text" name="NumeroComprobante" class="form-control" value="@c.NumeroComprobante" maxlength="50" required />
        </div>

        <div class="col-12">
            <label class="form-label">Observación</label>
            <textarea name="Observacion" class="form-control" maxlength="500" rows="2">@c.Observacion</textarea>
        </div>
    </div>

    <h5>Detalles de la compra</h5>

    <table class="table" id="tablaDetalles">
        <thead>
            <tr>
                <th style="width:35%">Producto</th>
                <th style="width:15%">Cantidad</th>
                <th style="width:20%">Costo Unitario (S/)</th>
                <th style="width:20%">Subtotal (S/)</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="detallesBody">
            <!-- filas agregadas por JS -->
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-bold">Total:</td>
                <td id="totalCompra" class="fw-bold">S/ 0.00</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <button type="button" id="btnAgregarDetalle" class="btn btn-outline-primary mb-3">
        <i class="bi bi-plus-lg"></i> Agregar producto
    </button>

    <div id="errorDetalles" class="alert alert-warning d-none">
        Debe agregar al menos un producto a la compra.
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Guardar Compra</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script>
        const productos = @Html.Raw(Json.Serialize(Model.Productos));
          let detalleIndex = 0;
        const tbody = document.getElementById('detallesBody');

           function crearOpcionesProducto(seleccionadoId) {
               let opciones = '<option value="">Seleccione...</option>';
              productos.forEach(p => {
                   const sel = String(p.idProducto) === String(seleccionadoId) ? 'selected' : '';
                   opciones += `<option value="${p.idProducto}" ${sel}>${p.codigo} - ${p.nombre}</option>`;
               });
               return opciones;
          }

              function agregarDetalle() {
                  const fila = document.createElement('tr');
               fila.innerHTML = `
                  <td>
                       <select class="form-select select-producto" required>
                          ${crearOpcionesProducto(null)}
                       </select>
                   </td>
                   <td>
                      <input type="number" class="form-control input-cantidad" min="1" step="1" value="1" required />
                   </td>
                  <td>
                      <input type="number" class="form-control input-costo" min="0" step="0.01" value="0.00" required />
                  </td>
                  <td class="subtotal-fila">S/ 0.00</td>
                  <td>
                      <button type="button" class="btn btn-sm btn-danger btn-quitar">
                          <i class="bi bi-trash"></i>
                      </button>
                  </td>
              `;
              tbody.appendChild(fila);

              fila.querySelector('.btn-quitar').addEventListener('click', () => {
                  fila.remove();
                  reindexarYCalcular();
              });
              fila.querySelector('.input-cantidad').addEventListener('input', reindexarYCalcular);
              fila.querySelector('.input-costo').addEventListener('input', reindexarYCalcular);

              reindexarYCalcular();
          }

           function reindexarYCalcular() {
               const filas = tbody.querySelectorAll('tr');
              let total = 0;

               filas.forEach((fila, i) => {
                   const selectProd = fila.querySelector('.select-producto');
                   const inputCant = fila.querySelector('.input-cantidad');
                  const inputCosto = fila.querySelector('.input-costo');
                   const celdaSubtotal = fila.querySelector('.subtotal-fila');

                  selectProd.name = `Detalles[${i}].IdProducto`;
                inputCant.name = `Detalles[${i}].Cantidad`;
                   inputCosto.name = `Detalles[${i}].CostoUnitario`;

                      const cantidad = parseFloat(inputCant.value) || 0;
                      const costo = parseFloat(inputCosto.value) || 0;
                   const subtotal = cantidad * costo;

                  celdaSubtotal.textContent = 'S/ ' + subtotal.toFixed(2);
                total += subtotal;
               });

                  document.getElementById('totalCompra').textContent = 'S/ ' + total.toFixed(2);
           }

        document.getElementById('btnAgregarDetalle').addEventListener('click', agregarDetalle);

          document.getElementById('formCompra').addEventListener('submit', function (e) {
              const filas = tbody.querySelectorAll('tr');
              const errorDiv = document.getElementById('errorDetalles');
              if (filas.length === 0) {
                  e.preventDefault();
                  errorDiv.classList.remove('d-none');
                  return;
              }
              errorDiv.classList.add('d-none');
              reindexarYCalcular();
          });

          const detallesExistentes = @Html.Raw(Json.Serialize(c.Detalles));
          if (detallesExistentes && detallesExistentes.length > 0) {
              detallesExistentes.forEach(d => {
                  agregarDetalle();
                  const filaActual = tbody.lastElementChild;
                  filaActual.querySelector('.select-producto').innerHTML = crearOpcionesProducto(d.idProducto);
                  filaActual.querySelector('.input-cantidad').value = d.cantidad;
                  filaActual.querySelector('.input-costo').value = d.costoUnitario;
              });
              reindexarYCalcular();
          } else {
              agregarDetalle();
          }
    </script>
}