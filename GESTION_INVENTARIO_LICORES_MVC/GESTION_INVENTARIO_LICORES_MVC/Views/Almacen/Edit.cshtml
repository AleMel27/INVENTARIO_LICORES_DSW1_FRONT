@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Request.AlmacenUpdateReqDto

@{
    ViewData["Title"] = "Editar Almacén";
    long idAlmacen = ViewData["IdAlmacen"] != null ? (long)ViewData["IdAlmacen"] : 0;
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-pencil-square text-warning me-2"></i>Editar Almacén <span class="badge bg-light text-secondary border font-monospace">#@idAlmacen</span>
                    </h5>
                </div>
                <form asp-action="Edit" asp-route-id="@idAlmacen" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label small fw-semibold text-secondary">Nombre <span class="text-danger">*</span></label>
                            <input asp-for="Nombre" class="form-control form-control-sm" placeholder="Nombre del almacén" autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Descripcion" class="form-label small fw-semibold text-secondary">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control form-control-sm" rows="3" placeholder="Descripción opcional..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="card-footer bg-light border-top py-2 px-4 d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-sm btn-warning fw-medium px-3">
                            <i class="bi bi-check-lg me-1"></i> Actualizar Almacén
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}