@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Request.UsuarioUpdateReqDto

@{
    ViewData["Title"] = "Editar Usuario";
    long idUsuario = ViewData["IdUsuario"] != null ? (long)ViewData["IdUsuario"] : 0;
}

<div class="container py-3" style="max-width: 650px;">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-primary fs-5"></i>
                <h5 class="fw-bold text-dark mb-0">Modificar Usuario</h5>
            </div>
            <span class="badge bg-light text-secondary border font-monospace px-2 py-1">ID: #@idUsuario</span>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@idUsuario" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombres" class="form-label small fw-semibold text-secondary">Nombres <span class="text-danger">*</span></label>
                        <input asp-for="Nombres" class="form-control form-control-sm" placeholder="Ingrese nombres" autocomplete="off" />
                        <span asp-validation-for="Nombres" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellidos" class="form-label small fw-semibold text-secondary">Apellidos <span class="text-danger">*</span></label>
                        <input asp-for="Apellidos" class="form-control form-control-sm" placeholder="Ingrese apellidos" autocomplete="off" />
                        <span asp-validation-for="Apellidos" class="text-danger small"></span>
                    </div>

                    <div class="col-md-7">
                        <label asp-for="Correo" class="form-label small fw-semibold text-secondary">Correo Electrónico <span class="text-danger">*</span></label>
                        <input asp-for="Correo" type="email" class="form-control form-control-sm" placeholder="ejemplo@correo.com" autocomplete="off" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="IdRol" class="form-label small fw-semibold text-secondary">Rol <span class="text-danger">*</span></label>
                        <select asp-for="IdRol" class="form-select form-select-sm" asp-items="ViewBag.Roles">
                            <option value="">-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="IdRol" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-sm btn-primary fw-medium px-3">
                        <i class="bi bi-check-lg me-1"></i> Actualizar Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}