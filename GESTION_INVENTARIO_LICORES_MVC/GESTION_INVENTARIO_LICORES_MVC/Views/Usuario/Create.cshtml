@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Request.UsuarioReqDto

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container py-3" style="max-width: 650px;">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-plus-fill text-primary fs-5"></i>
                <h5 class="fw-bold text-dark mb-0">Registrar Nuevo Usuario</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombres" class="form-label small fw-semibold text-secondary">Nombres <span class="text-danger">*</span></label>
                        <input asp-for="Nombres" class="form-control form-control-sm" placeholder="Ej. Juan Carlos" autocomplete="off" />
                        <span asp-validation-for="Nombres" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellidos" class="form-label small fw-semibold text-secondary">Apellidos <span class="text-danger">*</span></label>
                        <input asp-for="Apellidos" class="form-control form-control-sm" placeholder="Ej. Pérez Gómez" autocomplete="off" />
                        <span asp-validation-for="Apellidos" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Correo" class="form-label small fw-semibold text-secondary">Correo Electrónico <span class="text-danger">*</span></label>
                        <input asp-for="Correo" type="email" class="form-control form-control-sm" placeholder="ejemplo@correo.com" autocomplete="off" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Contraseña <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control form-control-sm" placeholder="Mínimo 8 caracteres" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdRol" class="form-label small fw-semibold text-secondary">Rol <span class="text-danger">*</span></label>
                        <select asp-for="IdRol" class="form-select form-select-sm" asp-items="ViewBag.Roles">
                            <option value="">-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="IdRol" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-sm btn-primary fw-medium px-3">
                        <i class="bi bi-check-lg me-1"></i> Guardar Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}