@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.UsuarioRespDto

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<div class="container py-3" style="max-width: 650px;">
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-primary fs-5"></i>
                <h5 class="fw-bold text-dark mb-0">Información del Usuario</h5>
            </div>
            <span class="badge bg-light text-secondary border font-monospace px-2 py-1">ID: #@Model.IdUsuario</span>
        </div>

        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="d-block text-secondary small fw-semibold">Nombres</span>
                    <span class="fs-6 text-dark fw-medium">@Model.Nombres</span>
                </div>

                <div class="col-sm-6">
                    <span class="d-block text-secondary small fw-semibold">Apellidos</span>
                    <span class="fs-6 text-dark fw-medium">@Model.Apellidos</span>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-sm-6">
                    <span class="d-block text-secondary small fw-semibold">Correo Electrónico</span>
                    <span class="fs-6 text-dark font-monospace">@Model.Correo</span>
                </div>

                <div class="col-sm-3">
                    <span class="d-block text-secondary small fw-semibold mb-1">Rol Asignado</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-normal px-2">
                        @(Model.Rol != null ? Model.Rol.Nombre : "Sin Rol")
                    </span>
                </div>

                <div class="col-sm-3">
                    <span class="d-block text-secondary small fw-semibold mb-1">Estado</span>
                    @if (Model.Estado)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-normal px-2">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill fw-normal px-2">Inactivo</span>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>
                <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-sm btn-primary fw-medium px-3">
                    <i class="bi bi-pencil me-1"></i> Editar Usuario
                </a>
            </div>
        </div>
    </div>
</div>