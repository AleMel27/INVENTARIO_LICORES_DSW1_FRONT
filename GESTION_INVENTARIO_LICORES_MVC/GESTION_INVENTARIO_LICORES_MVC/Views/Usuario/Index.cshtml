@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.PaginatedRespDto<GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.UsuarioRespDto>

@{
    ViewData["Title"] = "Gestión de Usuarios";

    string currentNombres = ViewData["CurrentNombres"] as string ?? "";
    string currentApellidos = ViewData["CurrentApellidos"] as string ?? "";
    long? currentIdRol = ViewData["CurrentIdRol"] as long?;
    int currentEstado = ViewData["CurrentEstado"] != null ? (int)ViewData["CurrentEstado"] : 0;
    string currentOrden = ViewData["CurrentOrden"] as string ?? "DESC";
    string nextOrden = currentOrden == "ASC" ? "DESC" : "ASC";
}

<div class="container-fluid px-4 py-3">
    <!-- Mensajes de Notificación -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado Principal -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-0">Gestión de Usuarios</h4>
            <span class="text-muted small">Administración de accesos y roles del sistema</span>
        </div>
        <a asp-action="Create" class="btn btn-sm btn-primary fw-medium px-3">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
        </a>
    </div>

    <!-- Barra de Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body p-3">
            <form id="filterForm" method="get" asp-action="Index">
                <input type="hidden" name="orden" value="@currentOrden" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label for="inputNombres" class="form-label small fw-semibold text-secondary mb-1">Nombres</label>
                        <input type="text"
                               id="inputNombres"
                               name="nombres"
                               class="form-control form-control-sm"
                               placeholder="Buscar por Nombres..."
                               value="@currentNombres"
                               autocomplete="off" />
                    </div>

                    <div class="col-md-3">
                        <label for="inputApellidos" class="form-label small fw-semibold text-secondary mb-1">Apellidos</label>
                        <input type="text"
                               id="inputApellidos"
                               name="apellidos"
                               class="form-control form-control-sm"
                               placeholder="Buscar por Apellidos..."
                               value="@currentApellidos"
                               autocomplete="off" />
                    </div>

                    <div class="col-md-2">
                        <label for="selectRol" class="form-label small fw-semibold text-secondary mb-1">Rol</label>
                        <select id="selectRol" name="idRol" class="form-select form-select-sm" asp-items="ViewBag.Roles">
                            <option value="">-- Todos --</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label for="selectEstado" class="form-label small fw-semibold text-secondary mb-1">Estado</label>
                        <select id="selectEstado" name="estado" class="form-select form-select-sm">
                            <option value="0" selected="@(currentEstado == 0)">Activos</option>
                            <option value="1" selected="@(currentEstado == 1)">Inactivos</option>
                            <option value="2" selected="@(currentEstado == 2)">Todos</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-medium">
                            <i class="bi bi-search me-1"></i> Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium" title="Limpiar Filtros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla Principal -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
                <thead class="table-light border-bottom">
                    <tr>
                        <th scope="col" style="width: 100px;" class="ps-3">
                            <a asp-action="Index"
                               asp-route-nombres="@currentNombres"
                               asp-route-apellidos="@currentApellidos"
                               asp-route-idRol="@currentIdRol"
                               asp-route-estado="@currentEstado"
                               asp-route-orden="@nextOrden"
                               class="text-secondary text-decoration-none d-flex align-items-center justify-content-between fw-semibold">
                                ID
                                @if (currentOrden == "ASC")
                                {
                                    <i class="bi bi-arrow-up text-primary"></i>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-down text-primary"></i>
                                }
                            </a>
                        </th>
                        <th scope="col" class="fw-semibold text-secondary">Nombres</th>
                        <th scope="col" class="fw-semibold text-secondary">Apellidos</th>
                        <th scope="col" class="fw-semibold text-secondary">Correo</th>
                        <th scope="col" class="fw-semibold text-secondary">Rol</th>
                        <th scope="col" class="text-center fw-semibold text-secondary" style="width: 110px;">Estado</th>
                        <th scope="col" class="text-end pe-3 fw-semibold text-secondary" style="width: 220px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3 font-monospace text-muted">#@item.IdUsuario</td>
                                <td class="fw-medium text-dark">@item.Nombres</td>
                                <td class="text-secondary">@item.Apellidos</td>
                                <td class="text-muted font-monospace small">@item.Correo</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-normal px-2">
                                        @(item.Rol != null ? item.Rol.Nombre : "Sin Rol")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-normal px-2">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill fw-normal px-2">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.IdUsuario" class="btn btn-light border text-secondary" title="Ver Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-light border text-secondary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-light border @(item.Estado ? "text-danger" : "text-success")"
                                                data-bs-toggle="modal"
                                                data-bs-target="#confirmStatusModal"
                                                data-id="@item.IdUsuario"
                                                data-nombre="@($"{item.Nombres} {item.Apellidos}")"
                                                data-estado="@item.Estado.ToString().ToLower()"
                                                title="@(item.Estado ? "Desactivar" : "Activar")">
                                            <i class="bi @(item.Estado ? "bi-slash-circle" : "bi-check-circle")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No se encontraron usuarios con los filtros seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Paginación -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-nombres="@currentNombres"
                       asp-route-apellidos="@currentApellidos"
                       asp-route-idRol="@currentIdRol"
                       asp-route-estado="@currentEstado"
                       asp-route-orden="@currentOrden">Anterior</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@i"
                           asp-route-nombres="@currentNombres"
                           asp-route-apellidos="@currentApellidos"
                           asp-route-idRol="@currentIdRol"
                           asp-route-estado="@currentEstado"
                           asp-route-orden="@currentOrden">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-nombres="@currentNombres"
                       asp-route-apellidos="@currentApellidos"
                       asp-route-idRol="@currentIdRol"
                       asp-route-estado="@currentEstado"
                       asp-route-orden="@currentOrden">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Formulario Oculto para cambio de estado -->
<form id="formChangeStatus" asp-action="ChangeStatus" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="inputEstadoActual" name="estadoActual" value="" />
</form>

<!-- Modal de Confirmación -->
<div class="modal fade" id="confirmStatusModal" tabindex="-1" aria-labelledby="confirmStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-3">
            <div class="modal-header border-bottom-0 pb-0" id="modalHeaderBg">
                <h6 class="modal-title fw-bold" id="confirmStatusModalLabel">Confirmar Acción</h6>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3 small text-secondary" id="modalBodyText">
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-sm btn-light border text-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm" id="btnConfirmStatus">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterForm = document.getElementById('filterForm');
            const selectEstado = document.getElementById('selectEstado');
            const selectRol = document.getElementById('selectRol');
            const inputNombres = document.getElementById('inputNombres');
            const inputApellidos = document.getElementById('inputApellidos');

            // Auto submit al cambiar dropdowns
            selectEstado.addEventListener('change', function() {
                filterForm.submit();
            });

            selectRol.addEventListener('change', function() {
                filterForm.submit();
            });

            // Auto submit con debounce al escribir en inputs
            let timeoutId;
            const triggerAutoSubmit = () => {
                clearTimeout(timeoutId);
                timeoutId = setTimeout(() => {
                    filterForm.submit();
                }, 400);
            };

            if (inputNombres) inputNombres.addEventListener('input', triggerAutoSubmit);
            if (inputApellidos) inputApellidos.addEventListener('input', triggerAutoSubmit);

            // Modal de confirmación
            const confirmModal = document.getElementById('confirmStatusModal');
            if (confirmModal) {
                confirmModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;

                    const id = button.getAttribute('data-id');
                    const nombre = button.getAttribute('data-nombre');
                    const esActivo = button.getAttribute('data-estado') === 'true';

                    const modalBodyText = document.getElementById('modalBodyText');
                    const btnConfirm = document.getElementById('btnConfirmStatus');
                    const form = document.getElementById('formChangeStatus');
                    const inputEstado = document.getElementById('inputEstadoActual');

                    form.action = `/Usuario/ChangeStatus/${id}`;
                    inputEstado.value = esActivo ? 'true' : 'false';

                    if (esActivo) {
                        modalBodyText.innerHTML = `¿Está seguro de que desea <strong>desactivar</strong> al usuario <strong>"${nombre}"</strong>?`;
                        btnConfirm.className = 'btn btn-sm btn-danger fw-medium px-3';
                        btnConfirm.textContent = 'Desactivar';
                    } else {
                        modalBodyText.innerHTML = `¿Está seguro de que desea <strong>activar</strong> al usuario <strong>"${nombre}"</strong>?`;
                        btnConfirm.className = 'btn btn-sm btn-success fw-medium px-3';
                        btnConfirm.textContent = 'Activar';
                    }

                    btnConfirm.onclick = function() {
                        form.submit();
                    };
                });
            }
        });
    </script>
}