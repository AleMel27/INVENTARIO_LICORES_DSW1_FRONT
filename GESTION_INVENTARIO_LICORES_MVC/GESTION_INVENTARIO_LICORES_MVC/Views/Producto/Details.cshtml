@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.ProductoRespDto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="container py-3" style="max-width: 720px;">
    <div class="card border-0 shadow-sm rounded-3">
        <!-- Encabezado de tarjeta -->
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center px-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-box-seam text-primary fs-5"></i>
                <h5 class="fw-bold text-dark mb-0">Detalles del Producto</h5>
            </div>
            <span class="badge bg-light text-secondary border font-monospace">ID #@Model.IdProducto</span>
        </div>

        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Código</span>
                    <span class="badge bg-light text-dark border font-monospace mt-1 px-2 py-1">@Model.Codigo</span>
                </div>

                <div class="col-sm-6">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Estado</span>
                    <div class="mt-1">
                        @if (Model.Estado)
                        {
                            <span class="badge bg-success-subtle text-success px-2 py-1">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Inactivo</span>
                        }
                    </div>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-12">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Nombre del Producto</span>
                    <p class="fs-5 fw-bold text-dark mb-0 mt-1">@Model.Nombre</p>
                </div>

                <div class="col-sm-6">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Categoría</span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle mt-1 px-2 py-1">
                        @(Model.Categoria != null ? Model.Categoria.Nombre : "Sin Categoría")
                    </span>
                </div>

                <div class="col-sm-6">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Marca</span>
                    <p class="text-dark fw-medium mb-0 mt-1">@(Model.Marca != null ? Model.Marca.Nombre : "Sin Marca")</p>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-12">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Descripción</span>
                    <p class="text-secondary mb-0 mt-1">@(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción registrada." : Model.Descripcion)</p>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-sm-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Capacidad</span>
                    <p class="text-dark fw-medium mb-0 mt-1">@Model.CapacidadMl ml</p>
                </div>

                <div class="col-sm-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Grado Alc.</span>
                    <p class="text-dark fw-medium mb-0 mt-1">@Model.GradoAlcoholico %</p>
                </div>

                <div class="col-sm-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Precio Venta</span>
                    <p class="text-dark fw-bold mb-0 mt-1">S/ @Model.PrecioVenta.ToString("N2")</p>
                </div>

                <div class="col-sm-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Stock Mínimo</span>
                    <p class="text-dark fw-medium mb-0 mt-1">@Model.StockMinimo unids.</p>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            <a asp-action="Edit" asp-route-id="@Model.IdProducto" class="btn btn-sm btn-primary fw-medium px-3">
                <i class="bi bi-pencil me-1"></i> Editar
            </a>
        </div>
    </div>
</div>