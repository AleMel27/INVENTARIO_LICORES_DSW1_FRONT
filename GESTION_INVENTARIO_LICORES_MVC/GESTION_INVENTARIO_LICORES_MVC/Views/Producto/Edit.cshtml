@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Request.ProductoUpdateReqDto

@{
    ViewData["Title"] = "Editar Producto";
    long idProducto = ViewData["IdProducto"] != null ? (long)ViewData["IdProducto"] : 0;
    string codigoProducto = ViewData["CodigoProducto"] as string ?? "";
}

<div class="container py-3" style="max-width: 760px;">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-primary fs-5"></i>
                <h5 class="fw-bold text-dark mb-0">Editar Producto</h5>
            </div>
            <span class="badge bg-light text-secondary border font-monospace">#@idProducto</span>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@idProducto" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Código</label>
                        <input type="text" class="form-control form-control-sm bg-light font-monospace" value="@codigoProducto" readonly />
                        <span class="text-muted" style="font-size: 0.75rem;">No modificable.</span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Nombre" class="form-label small fw-semibold text-secondary">Nombre <span class="text-danger">*</span></label>
                        <input asp-for="Nombre" class="form-control form-control-sm" placeholder="Ej. Whisky Red Label 750ml" autocomplete="off" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdCategoria" class="form-label small fw-semibold text-secondary">Categoría <span class="text-danger">*</span></label>
                        <select asp-for="IdCategoria" class="form-select form-select-sm" asp-items="ViewBag.Categorias">
                            <option value="">-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdMarca" class="form-label small fw-semibold text-secondary">Marca <span class="text-danger">*</span></label>
                        <select asp-for="IdMarca" class="form-select form-select-sm" asp-items="ViewBag.Marcas">
                            <option value="">-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="IdMarca" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label small fw-semibold text-secondary">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control form-control-sm" rows="2" placeholder="Detalles u observaciones del producto..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="CapacidadMl" class="form-label small fw-semibold text-secondary">Capacidad <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <input asp-for="CapacidadMl" type="number" class="form-control" />
                            <span class="input-group-text bg-light text-muted">ml</span>
                        </div>
                        <span asp-validation-for="CapacidadMl" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="GradoAlcoholico" class="form-label small fw-semibold text-secondary">Grado Alc.</label>
                        <div class="input-group input-group-sm">
                            <input asp-for="GradoAlcoholico" type="number" step="0.1" class="form-control" />
                            <span class="input-group-text bg-light text-muted">%</span>
                        </div>
                        <span asp-validation-for="GradoAlcoholico" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="PrecioVenta" class="form-label small fw-semibold text-secondary">Precio <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted">S/</span>
                            <input asp-for="PrecioVenta" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="StockMinimo" class="form-label small fw-semibold text-secondary">Stock Mínimo</label>
                        <input asp-for="StockMinimo" type="number" class="form-control form-control-sm" />
                        <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-medium px-3">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-sm btn-primary fw-medium px-3">
                        <i class="bi bi-check-lg me-1"></i> Actualizar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}