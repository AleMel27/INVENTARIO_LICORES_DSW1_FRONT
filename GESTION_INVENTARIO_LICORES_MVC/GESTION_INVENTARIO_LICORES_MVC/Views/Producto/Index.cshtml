@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.PaginatedRespDto<GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.ProductoRespDto>

@{
    ViewData["Title"] = "Gestión de Productos";

    string currentCodigo = ViewData["CurrentCodigo"] as string ?? "";
    string currentNombre = ViewData["CurrentNombre"] as string ?? "";
    long? currentIdCategoria = ViewData["CurrentIdCategoria"] as long?;
    long? currentIdMarca = ViewData["CurrentIdMarca"] as long?;
    int currentEstado = ViewData["CurrentEstado"] != null ? (int)ViewData["CurrentEstado"] : 0;
    string currentOrden = ViewData["CurrentOrden"] as string ?? "DESC";
    string nextOrden = currentOrden == "ASC" ? "DESC" : "ASC";
}

<div class="container-fluid px-4 mt-4">
    <!-- Mensajes de Notificación -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-box-seam me-2"></i>Listado de Productos</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
        </a>
    </div>

    <!-- Barra de Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light">
            <form id="filterForm" method="get" asp-action="Index">
                <input type="hidden" name="orden" value="@currentOrden" />

                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label for="inputCodigo" class="form-label fw-bold">Código</label>
                        <input type="text" 
                               id="inputCodigo" 
                               name="codigo" 
                               class="form-control" 
                               placeholder="Buscar por código..." 
                               value="@currentCodigo" 
                               autocomplete="off" />
                    </div>

                    <div class="col-md-3">
                        <label for="inputNombre" class="form-label fw-bold">Nombre</label>
                        <input type="text" 
                               id="inputNombre" 
                               name="nombre" 
                               class="form-control" 
                               placeholder="Buscar por nombre..." 
                               value="@currentNombre" 
                               autocomplete="off" />
                    </div>

                    <div class="col-md-2">
                        <label for="selectCategoria" class="form-label fw-bold">Categoría</label>
                        <select id="selectCategoria" name="idCategoria" class="form-select" asp-items="ViewBag.Categorias">
                            <option value="">-- Todas --</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label for="selectMarca" class="form-label fw-bold">Marca</label>
                        <select id="selectMarca" name="idMarca" class="form-select" asp-items="ViewBag.Marcas">
                            <option value="">-- Todas --</option>
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label for="selectEstado" class="form-label fw-bold">Estado</label>
                        <select id="selectEstado" name="estado" class="form-select">
                            <option value="0" selected="@(currentEstado == 0)">Activos</option>
                            <option value="1" selected="@(currentEstado == 1)">Inactivos</option>
                            <option value="2" selected="@(currentEstado == 2)">Todos</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar Filtros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla principal -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width: 100px;">
                            <a asp-action="Index" 
                               asp-route-codigo="@currentCodigo"
                               asp-route-nombre="@currentNombre"
                               asp-route-idCategoria="@currentIdCategoria"
                               asp-route-idMarca="@currentIdMarca"
                               asp-route-estado="@currentEstado" 
                               asp-route-orden="@nextOrden" 
                               class="text-white text-decoration-none d-flex align-items-center justify-content-between">
                                ID
                                @if (currentOrden == "ASC")
                                {
                                    <i class="bi bi-arrow-up-short fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-down-short fs-5"></i>
                                }
                            </a>
                        </th>
                        <th scope="col">Código</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Marca</th>
                        <th scope="col" class="text-end">Capacidad</th>
                        <th scope="col" class="text-end">Precio</th>
                        <th scope="col" class="text-center" style="width: 100px;">Estado</th>
                        <th scope="col" class="text-center" style="width: 230px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><strong>#@item.IdProducto</strong></td>
                                <td><span class="badge bg-secondary">@item.Codigo</span></td>
                                <td>@item.Nombre</td>
                                <td>@(item.Categoria != null ? item.Categoria.Nombre : "Sin Categoría")</td>
                                <td>@(item.Marca != null ? item.Marca.Nombre : "Sin Marca")</td>
                                <td class="text-end">@item.CapacidadMl ml</td>
                                <td class="text-end fw-bold">S/ @item.PrecioVenta.ToString("N2")</td>
                                <td class="text-center">
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-info">
                                            Detalles
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-warning">
                                            Editar
                                        </a>

                                        <button type="button" 
                                                class="btn btn-sm @(item.Estado ? "btn-outline-danger" : "btn-outline-success")"
                                                data-bs-toggle="modal" 
                                                data-bs-target="#confirmStatusModal"
                                                data-id="@item.IdProducto"
                                                data-nombre="@item.Nombre"
                                                data-estado="@item.Estado.ToString().ToLower()">
                                            @(item.Estado ? "Desactivar" : "Activar")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No se encontraron productos con los filtros seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Paginación -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" 
                       asp-action="Index" 
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-codigo="@currentCodigo"
                       asp-route-nombre="@currentNombre"
                       asp-route-idCategoria="@currentIdCategoria"
                       asp-route-idMarca="@currentIdMarca"
                       asp-route-estado="@currentEstado"
                       asp-route-orden="@currentOrden">Anterior</a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" 
                           asp-action="Index" 
                           asp-route-pageNumber="@i"
                           asp-route-codigo="@currentCodigo"
                           asp-route-nombre="@currentNombre"
                           asp-route-idCategoria="@currentIdCategoria"
                           asp-route-idMarca="@currentIdMarca"
                           asp-route-estado="@currentEstado"
                           asp-route-orden="@currentOrden">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" 
                       asp-action="Index" 
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-codigo="@currentCodigo"
                       asp-route-nombre="@currentNombre"
                       asp-route-idCategoria="@currentIdCategoria"
                       asp-route-idMarca="@currentIdMarca"
                       asp-route-estado="@currentEstado"
                       asp-route-orden="@currentOrden">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Formulario Oculto para cambio de estado -->
<form id="formChangeStatus" asp-action="ChangeStatus" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="inputEstadoActual" name="estadoActual" value="" />
</form>

<!-- Modal de Confirmación -->
<div class="modal fade" id="confirmStatusModal" tabindex="-1" aria-labelledby="confirmStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" id="modalHeaderBg">
                <h5 class="modal-title" id="confirmStatusModalLabel">Confirmar Acción</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBodyText">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn" id="btnConfirmStatus">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterForm = document.getElementById('filterForm');
            const selectEstado = document.getElementById('selectEstado');
            const selectCategoria = document.getElementById('selectCategoria');
            const selectMarca = document.getElementById('selectMarca');
            const inputCodigo = document.getElementById('inputCodigo');
            const inputNombre = document.getElementById('inputNombre');

            // Auto submit en dropdowns
            [selectEstado, selectCategoria, selectMarca].forEach(el => {
                if(el) el.addEventListener('change', () => filterForm.submit());
            });

            // Auto submit con debounce al escribir
            let timeoutId;
            const triggerAutoSubmit = () => {
                clearTimeout(timeoutId);
                timeoutId = setTimeout(() => {
                    filterForm.submit();
                }, 400);
            };

            if (inputCodigo) inputCodigo.addEventListener('input', triggerAutoSubmit);
            if (inputNombre) inputNombre.addEventListener('input', triggerAutoSubmit);

            // Modal confirmación
            const confirmModal = document.getElementById('confirmStatusModal');
            if (confirmModal) {
                confirmModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    
                    const id = button.getAttribute('data-id');
                    const nombre = button.getAttribute('data-nombre');
                    const esActivo = button.getAttribute('data-estado') === 'true';

                    const modalHeaderBg = document.getElementById('modalHeaderBg');
                    const modalBodyText = document.getElementById('modalBodyText');
                    const btnConfirm = document.getElementById('btnConfirmStatus');
                    const form = document.getElementById('formChangeStatus');
                    const inputEstado = document.getElementById('inputEstadoActual');

                    form.action = `/Producto/ChangeStatus/${id}`;
                    inputEstado.value = esActivo ? 'true' : 'false';

                    if (esActivo) {
                        modalHeaderBg.className = 'modal-header bg-danger text-white';
                        modalBodyText.innerHTML = `¿Está seguro de que desea <strong>desactivar</strong> el producto <strong>"${nombre}"</strong>?`;
                        btnConfirm.className = 'btn btn-danger';
                        btnConfirm.textContent = 'Sí, Desactivar';
                    } else {
                        modalHeaderBg.className = 'modal-header bg-success text-white';
                        modalBodyText.innerHTML = `¿Está seguro de que desea <strong>activar</strong> el producto <strong>"${nombre}"</strong>?`;
                        btnConfirm.className = 'btn btn-success';
                        btnConfirm.textContent = 'Sí, Activar';
                    }

                    btnConfirm.onclick = function () {
                        form.submit();
                    };
                });
            }
        });
    </script>
}