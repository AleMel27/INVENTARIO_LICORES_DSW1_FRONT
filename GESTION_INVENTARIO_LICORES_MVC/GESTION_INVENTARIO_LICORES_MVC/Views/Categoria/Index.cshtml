@model GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.PaginatedRespDto<GESTION_INVENTARIO_LICORES_MVC.DTOs.Response.CategoriaRespDto>

@{
    ViewData["Title"] = "Gestión de Categorías";

    string currentNombre = ViewData["CurrentNombre"] as string ?? "";
    int currentEstado = ViewData["CurrentEstado"] != null ? (int)ViewData["CurrentEstado"] : 0;
    string currentOrden = ViewData["CurrentOrden"] as string ?? "DESC";
    string nextOrden = currentOrden == "ASC" ? "DESC" : "ASC";
}

<div class="container-fluid py-2">
    <!-- Mensajes de Notificación -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Catálogo de Categorías</h3>
            <p class="text-muted small mb-0">Administra las categorías de productos registradas en el sistema.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm px-3 py-2">
            <i class="bi bi-plus-circle fs-6"></i>
            <span class="fw-medium">Nueva Categoría</span>
        </a>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form id="filterForm" method="get" asp-action="Index">
                <input type="hidden" name="orden" value="@currentOrden" />

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6">
                        <label for="inputNombre" class="form-label small fw-semibold text-secondary">Nombre</label>
                        <input type="text" id="inputNombre" name="nombre" class="form-control form-control-sm" placeholder="Buscar por nombre..." value="@currentNombre" autocomplete="off" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="selectEstado" class="form-label small fw-semibold text-secondary">Estado</label>
                        <select id="selectEstado" name="estado" class="form-select form-select-sm">
                            <option value="0" selected="@(currentEstado == 0)">Activos</option>
                            <option value="1" selected="@(currentEstado == 1)">Inactivos</option>
                            <option value="2" selected="@(currentEstado == 2)">Todos</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-secondary w-100 fw-medium">
                            <i class="bi bi-funnel me-1"></i> Filtrar
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-light border text-secondary" title="Limpiar Filtros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla Principal -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3 py-3" style="width: 100px;">
                                <a asp-action="Index"
                                   asp-route-nombre="@currentNombre"
                                   asp-route-estado="@currentEstado"
                                   asp-route-orden="@nextOrden"
                                   class="text-secondary text-decoration-none d-flex align-items-center gap-1">
                                    ID
                                    <i class="bi bi-arrow-down-up opacity-50"></i>
                                </a>
                            </th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Descripción</th>
                            <th scope="col" class="text-center" style="width: 100px;">Estado</th>
                            <th scope="col" class="text-center pe-3" style="width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        @if (Model != null && Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3 font-monospace text-muted small">#@item.IdCategoria</td>
                                    <td class="fw-semibold text-dark">@item.Nombre</td>
                                    <td class="text-secondary">@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                                    <td class="text-center">
                                        @if (item.Estado)
                                        {
                                            <span class="badge bg-success-subtle text-success px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.IdCategoria" class="btn btn-light border text-secondary" title="Ver Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.IdCategoria" class="btn btn-light border text-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-light border @(item.Estado ? "text-danger" : "text-success")"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#confirmStatusModal"
                                                    data-id="@item.IdCategoria"
                                                    data-nombre="@item.Nombre"
                                                    data-estado="@item.Estado.ToString().ToLower()"
                                                    title="@(item.Estado ? "Desactivar" : "Activar")">
                                                <i class="bi @(item.Estado ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                    No se encontraron categorías con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link text-secondary"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-nombre="@currentNombre"
                       asp-route-estado="@currentEstado"
                       asp-route-orden="@currentOrden">Anterior</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@i"
                           asp-route-nombre="@currentNombre"
                           asp-route-estado="@currentEstado"
                           asp-route-orden="@currentOrden">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link text-secondary"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-nombre="@currentNombre"
                       asp-route-estado="@currentEstado"
                       asp-route-orden="@currentOrden">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Formulario Oculto para cambio de estado -->
<form id="formChangeStatus" asp-action="ChangeStatus" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="inputEstadoActual" name="estadoActual" value="" />
</form>

<!-- Modal de Confirmación -->
<div class="modal fade" id="confirmStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            <div class="modal-header border-bottom py-3" id="modalHeaderBg">
                <h6 class="modal-title fw-bold text-dark" id="confirmStatusModalLabel">Confirmar Acción</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4 text-secondary" id="modalBodyText">
            </div>
            <div class="modal-footer border-top py-2 bg-light">
                <button type="button" class="btn btn-sm btn-light border text-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm fw-medium" id="btnConfirmStatus">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterForm = document.getElementById('filterForm');
            const selectEstado = document.getElementById('selectEstado');
            const inputNombre = document.getElementById('inputNombre');

            if (selectEstado) {
                selectEstado.addEventListener('change', () => filterForm.submit());
            }

            let timeoutId;
            if (inputNombre) {
                inputNombre.addEventListener('input', () => {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => filterForm.submit(), 400);
                });

                if (inputNombre.value.length > 0) {
                    inputNombre.focus();
                    inputNombre.setSelectionRange(inputNombre.value.length, inputNombre.value.length);
                }
            }

            const confirmModal = document.getElementById('confirmStatusModal');
            if (confirmModal) {
                confirmModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const nombre = button.getAttribute('data-nombre');
                    const esActivo = button.getAttribute('data-estado') === 'true';

                    const modalBodyText = document.getElementById('modalBodyText');
                    const btnConfirm = document.getElementById('btnConfirmStatus');
                    const form = document.getElementById('formChangeStatus');
                    const inputEstado = document.getElementById('inputEstadoActual');

                    form.action = `/Categoria/ChangeStatus/${id}`;
                    inputEstado.value = esActivo ? 'true' : 'false';

                    if (esActivo) {
                        modalBodyText.innerHTML = `¿Está seguro de que desea <strong class="text-danger">desactivar</strong> la categoría <strong>"${nombre}"</strong>?`;
                        btnConfirm.className = 'btn btn-sm btn-danger fw-medium';
                        btnConfirm.textContent = 'Sí, Desactivar';
                    } else {
                        modalBodyText.innerHTML = `¿Está seguro de que desea <strong class="text-success">activar</strong> la categoría <strong>"${nombre}"</strong>?`;
                        btnConfirm.className = 'btn btn-sm btn-success fw-medium';
                        btnConfirm.textContent = 'Sí, Activar';
                    }

                    btnConfirm.onclick = function() {
                        form.submit();
                    };
                });
            }
        });
    </script>
}